# Copy to .env for local development. Real values go in Railway's
# environment variables. Never commit real keys.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
OPERATOR_JWT_SECRET=at-least-32-random-characters
CORS_ORIGINS=https://strippals.com,https://www.strippals.com
PORT=4000

# --- Paystack (credit purchases) ---
# Secret key from Paystack Dashboard > Settings > API Keys & Webhooks.
# Use sk_test_... while testing, then switch to sk_live_...
PAYSTACK_SECRET_KEY=your-paystack-secret-key
# Currency the packages are charged in (must be enabled on your Paystack account)
PAYSTACK_CURRENCY=USD
# Optional: where Paystack sends the customer back after a bank redirect
PAYSTACK_CALLBACK_URL=https://strippals.com/credits

# Operator photo sending (paused unless "true")
PRIVATE_PHOTOS_ENABLED=false
